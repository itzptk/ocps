{
  "name": "@itzptk/ocps",
  "version": "1.1.0",
  "description": "opencode plugin starter — scaffold a new opencode plugin project via `npx ocps init`",
  "type": "module",
  "bin": {
    "ocps": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/cli.ts ./src/index.ts --outdir ./dist --target node",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "latest",
    "bun-types": "^1.3.14",
    "typescript": "latest"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "scaffold",
    "template",
    "boilerplate",
    "starter",
    "generator",
    "create"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzptk/ocps.git"
  },
  "bugs": {
    "url": "https://github.com/itzptk/ocps/issues"
  },
  "homepage": "https://github.com/itzptk/ocps#readme"
}
